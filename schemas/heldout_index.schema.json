{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "svp": "0.5",
  "title": "SwarmLabs heldout_index.json schema (L-11, 2026-10-17)",
  "description": "契约化 frontend_fixed/reports/heldout_index.json —— 73/82 三分母与外推压力协议（G1/G2/G3）的入口产物。",
  "type": "object",
  "required": ["name", "version", "robustness_heldout", "extrapolation_stress"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "note": { "type": "string" },
    "robustness_heldout": { "$ref": "#/definitions/heldoutSection" },
    "extrapolation_stress": { "$ref": "#/definitions/heldoutSection" }
  },
  "definitions": {
    "heldoutSection": {
      "type": "object",
      "required": ["counts", "total", "scenarios"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "counts": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key"],
            "additionalProperties": true,
            "properties": {
              "key": { "type": "string" },
              "verdict": { "type": "string" },
              "doi_present": { "type": "boolean" }
            }
          }
        }
      },
      "additionalProperties": true
    }
  }
}
