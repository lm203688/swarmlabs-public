{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "svp": "0.5",
  "title": "SwarmLabs wet_lab_anchors.json schema (L-11, 2026-10-17)",
  "description": "契约化 frontend_fixed/reports/wet_lab_anchors.json —— 19 个真实文献锚点。INV-3（三维证据完整性）的入口产物。",
  "type": "object",
  "required": ["generated_at_utc", "anchors", "summary"],
  "additionalProperties": true,
  "properties": {
    "generated_at_utc": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "purpose": { "type": "string" },
    "note": { "type": "string" },
    "elapsed_s": { "type": "number" },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "label"],
        "additionalProperties": true,
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "unit": { "type": "string" },
          "lo": { "type": ["number", "null"] },
          "hi": { "type": ["number", "null"] },
          "sources": { "type": "array", "items": { "type": "string" } },
          "scenarios": { "type": "array" },
          "value_key": { "type": ["string", "null"] },
          "decision_relevant": { "type": "boolean" },
          "experiment_system": { "type": ["string", "null"] },
          "version": { "type": ["string", "null"] },
          "operating_condition": { "type": ["string", "null"] }
        }
      }
    },
    "summary": { "type": "object" },
    "scenarios": { "type": "array" }
  }
}
