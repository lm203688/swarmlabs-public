{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gate Ledger Schema",
  "description": "Autonomous-loop gate decisions. Build.source MUST be a script (not the display layer) — architecture-inversion guard.",
  "type": "object",
  "required": [
    "name",
    "version",
    "generated_at_utc",
    "build",
    "counts",
    "total",
    "scenarios"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Ledger version stamp (may be date-formatted like 2026-09-15)"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "standard": {
      "type": "string"
    },
    "build": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "scripts/build_gate_ledger.py"
          ],
          "description": "Build source — MUST be a build script, never the display layer (frontend_fixed/...)."
        },
        "reads_from": {
          "type": "string",
          "description": "Upstream data file read by the build script"
        },
        "complete": {
          "type": "boolean"
        },
        "registry_total": {
          "type": "integer",
          "minimum": 0
        },
        "dropped_scenarios": {
          "type": "array"
        },
        "optional_deps": {
          "type": "object",
          "additionalProperties": true
        },
        "note": {
          "type": "string"
        }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "noise_floor",
        "nominal_coverage",
        "gate_map"
      ],
      "additionalProperties": true
    },
    "calibration": {
      "type": "object",
      "additionalProperties": true
    },
    "counts": {
      "type": "object",
      "required": [
        "PASS",
        "MARGINAL",
        "REFUTED"
      ],
      "properties": {
        "PASS": { "type": "integer", "minimum": 0 },
        "MARGINAL": { "type": "integer", "minimum": 0 },
        "REFUTED": { "type": "integer", "minimum": 0 },
        "ERROR": { "type": "integer", "minimum": 0 }
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of scenarios. Must equal PASS + MARGINAL + REFUTED + ERROR."
    },
    "n_blocked": {
      "type": "integer",
      "minimum": 0
    },
    "n_human_check_required": {
      "type": "integer",
      "minimum": 0
    },
    "blocked": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Scenario keys blocked for autonomous action"
    },
    "human_check_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Scenario keys requiring human review before action"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "scenarios": {
      "type": "object",
      "description": "Map of scenario_key -> gate decision",
      "additionalProperties": {
        "type": "object",
        "required": [
          "verdict"
        ],
        "properties": {
          "gate": {
            "type": "string",
            "enum": [
              "PROCEED",
              "PROCEED_WITH_HUMAN_CHECK",
              "BLOCK_AUTONOMOUS_ACTION"
            ]
          },
          "verdict": {
            "type": "string",
            "enum": [
              "PASS",
              "MARGINAL",
              "REFUTED",
              "ERROR"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "uncertainty": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
