.uploads/
.wrangler/

# 构建产物：V&V 归档包可由 scripts/build_vv_package.py 一条命令重建，
# 不入库（避免每次重建都在仓库留下 7MB 二进制差异）。
# 注意：不可写成 *.zip —— 仓库里有 10 个合法入库的 zip（赛事作品包/数据集），
# 通配会静默挡住它们后续的更新。
dist/

# Zenodo 存档包：可由 scripts/build_zenodo_package.py 一条命令重建（含 MANIFEST.json
# sha256 全量清单），供用户侧上传 DOI；454 文件/7.6MB 派生产物不入库。
archives/

# 代理模型二进制：可由 scripts/train_chem_surrogates.py 从入库数据集重建，
# 不入库（133MB 二进制差异）。数据集本身入库，不受此规则影响。
# 只限定本目录，勿写成全局 *.pkl / *.pt。README.md 与 *.json 仍入库。
data/ml_models/**/*.pkl
data/ml_models/**/*.pt

