    "/v2/suggest/{engine}": {
      "get": {
        "tags": [
          "engine"
        ],
        "summary": "主动学习/贝叶斯优化",
        "security": [],
        "parameters": [
          {
            "name": "engine",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "suggestions"
          }
        }
      }
    },
    "/v2/model/{engine}": {
      "get": {
        "tags": [
          "engine"
        ],
        "summary": "当前高斯过程代理状态",
        "security": [],
        "parameters": [
          {
            "name": "engine",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "model/n_training/has_feedback"
