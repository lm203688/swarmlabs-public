    "/v3/verify/oracle": {
      "post": {
        "tags": [
          "verify"
        ],
        "summary": "任意点验证 - JS side Chebyshev oracle",
        "security": [],
        "description": "接受任意 (x, y_pred, y_std?) 三元组, 用 JS Chebyshev 求值器算真实值, 复用 gate_policy 做门禁判定. 仅 1D-3D 场景 (75/95) 已导出系数.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "scenario_key",
                  "predictions"
                ],
                "properties": {
                  "scenario_key": {
                    "type": "string",
                    "example": "bio_logistic"
                  },
                  "predictions": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "x",
                        "y_pred"
                      ],
                      "properties": {
                        "x": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        },
                        "y_pred": {
                          "type": "number"
                        },
                        "y_std": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已裁决",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OracleVerifyResponse"
                }
              }
            }
          },
          "400": {
            "description": "bad_request"
          },
          "404": {
            "description": "oracle_not_available"
          },
          "405": {
            "description": "method_not_allowed"
          },
          "500": {
            "description": "oracle_eval_failed"
          },
          "503": {
            "description": "policy_unavailable"
          }
        }
      }
    },
