    "/v3/gate/{key}": {
      "get": {
        "tags": [
          "gate"
        ],
        "summary": "获取单个场景的信任闸门决策",
        "security": [],
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
