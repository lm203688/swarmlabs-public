              "type": "string"
            },
            "example": "bio_logistic"
          }
        ],
        "responses": {
          "200": {
            "description": "闸门决策与不确定度预算",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateDecision"
                }
              }
            }
          },
          "404": {
            "description": "该场景不存在"
          }
        }
      }
    },
