{
  "openapi": "3.0.3",
  "info": {
    "title": "SwarmLabs API",
    "version": "3.5.0",
    "description": "面向科学研发的 AI 多智能体计算引擎平台。提供 115 个科学计算引擎，每次预测均返回真实文献溯源(DOI)、单点不确定度(UQ)与 A/B/C 数据驱动分级。95 个跨域验证场景，V&V 归档包可离线复验（发布口径 91 PASS / 3 MARGINAL / 1 REFUTED）。认证：Bearer 用户会话 token(stk_ 前缀)或 x-api-key。v2/ 前缀端点免 API key。"
  },
  "servers": [
    {
      "url": "https://swarmlabs.tools",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "engine",
      "description": "V2 计算引擎"
    },
    {
      "name": "verify",
      "description": "V3 验证闸门"
    },
    {
      "name": "gate",
      "description": "信任闸门账本"
    },
    {
      "name": "anchors",
      "description": "湿实验锚定"
    },
    {
      "name": "benchmark",
      "description": "基准索引"
    },
    {
      "name": "entity",
      "description": "实体库查询"
    },
    {
      "name": "report",
      "description": "V&V 报告"
    },
    {
      "name": "auth",
      "description": "认证与账户"
    },
    {
      "name": "mcp",
      "description": "MCP Server HTTP endpoints — tool discovery and invocation"
    }
  ],
  "paths": {
    "/v2/health": {
      "get": {
        "tags": [
          "engine"
        ],
        "summary": "健康检查与平台能力清单",
        "security": [],
        "responses": {
          "200": {
            "description": "返回引擎数、类别、物理模型数、特性列表"
          }
        }
      }
    },
    "/v2/literature": {
      "get": {
        "tags": [
          "engine"
        ],
        "summary": "全量引擎文献支撑概览",
        "security": [],
        "responses": {
          "200": {
            "description": "engines_covered / total_entries / 来源说明"
          }
        }
      }
    },
    "/v2/literature/{engine}": {
      "get": {
        "tags": [
          "engine"
        ],
        "summary": "指定引擎的真实文献",
        "security": [],
        "parameters": [
          {
            "name": "engine",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "suzuki"
          }
        ],
        "responses": {
          "200": {
            "description": "references 列表"
          },
          "404": {
            "description": "该引擎无索引文献"
          }
        }
      }
    },
    "/v2/negative-samples": {
      "get": {
        "tags": [
          "engine"
        ],
        "summary": "负样本/失败案例库",
        "security": [],
        "responses": {
          "200": {
            "description": "total / by_signal / engines_covered / samples"
          }
        }
      }
    },
    "/v2/negative-samples/{engine}": {
      "get": {
        "tags": [
          "engine"
        ],
        "summary": "指定引擎的负样本",
        "security": [],
        "parameters": [
          {
            "name": "engine",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "count / samples"
          }
        }
      }
    },
    "/v2/run/{engine}": {
      "post": {
        "tags": [
          "engine"
        ],
        "summary": "运行一次物理模型预测",
        "parameters": [
          {
            "name": "engine",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "suzuki"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "temperature_C": {
                    "type": "number",
                    "example": 80
                  },
                  "catalyst_loading": {
                    "type": "number",
                    "example": 0.02
                  },
                  "time_h": {
                    "type": "number",
                    "example": 4
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "result / primary_metric / metric_unit / uncertainty / confidence_grade / recommendation / literature_support / validation_stats"
          },
          "402": {
            "description": "积分余额不足"
          }
        }
      }
    },
    "/v2/sweep/{engine}": {
      "post": {
        "tags": [
          "engine"
        ],
        "summary": "参数扫描",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "engine": {
                    "type": "string"
                  },
                  "sweep_param": {
                    "type": "string",
                    "default": "temperature_C"
                  },
                  "points": {
                    "type": "integer",
                    "default": 10,
                    "maximum": 50
                  },
                  "fixed": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "series 列表"
          }
        }
      }
    },
    "/v2/enterprise": {
      "get": {
        "tags": [
          "engine"
        ],
        "summary": "商业化方案",
        "security": [],
        "responses": {
          "200": {
            "description": "tiers / enterprise_includes / compute_partnership"
          }
        }
      }
    },
    "/v2/account": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "账户余额与分级",
        "responses": {
          "200": {
            "description": "authenticated / credits_balance / tier"
          },
          "401": {
            "description": "未登录或 token 失效"
          }
        }
      }
    },
    "/v2/feedback": {
      "post": {
        "tags": [
          "engine"
        ],
        "summary": "提交真实实验反馈",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "engine"
                ],
                "properties": {
                  "engine": {
                    "type": "string",
                    "example": "distillation"
                  },
                  "predicted": {
                    "type": "number"
                  },
                  "actual": {
                    "type": "number"
                  },
                  "signal": {
                    "type": "string",
                    "enum": [
                      "higher_than_predicted",
                      "lower_than_predicted",
                      "match",
                      "failed",
                      "other"
                    ]
                  },
                  "context": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "accepted / note / entry"
          }
        }
      }
    },
    "/v2/feedback/summary": {
      "get": {
        "tags": [
          "engine"
        ],
        "summary": "反馈飞轮可见化",
        "security": [],
        "responses": {
          "200": {
            "description": "total_feedback / engines / top_engines / engine_details"
          }
        }
      }
    },
    "/v2/my-experiments": {
      "get": {
        "tags": [
          "engine"
        ],
        "summary": "取回当前用户的实验结果",
        "responses": {
          "200": {
            "description": "email / count / experiments"
          },
          "401": {
            "description": "未登录"
          }
        }
      }
    },
    "/v2/my-experiments/{engine}": {
      "get": {
        "tags": [
          "engine"
        ],
        "summary": "取回指定引擎的实验结果",
        "parameters": [
          {
            "name": "engine",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "同 /v2/my-experiments"
          },
          "401": {
            "description": "未登录"
          }
        }
      }
    },
    "/v2/reapply": {
      "post": {
        "tags": [
          "engine"
        ],
        "summary": "实验结果再应用",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source_id": {
                    "type": "string"
                  },
                  "use_my_experiments": {
                    "type": "boolean"
                  },
                  "source_engine": {
                    "type": "string"
                  },
                  "target_engine": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "anchored_on / injected_points / n_training / suggestions"
          },
          "401": {
            "description": "未登录"
          },
          "403": {
            "description": "source_id 不是你自己的实验"
          },
          "404": {
            "description": "目标引擎未知"
          }
        }
      }
    },
    "/v2/leaderboard": {
      "get": {
        "tags": [
          "engine"
        ],
        "summary": "贡献积分榜",
        "security": [],
        "responses": {
          "200": {
            "description": "top_contributors"
          }
        }
      }
    },
    "/v2/account/apikey": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "读取自带 API 配置",
        "responses": {
          "200": {
            "description": "configured / provider / masked / baseUrl / model"
          },
          "401": {
            "description": "未登录"
          }
        }
      },
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "保存或删除自带 API 密钥",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "enum": [
                      "openai",
                      "deepseek",
                      "qwen",
                      "moonshot",
                      "ollama",
                      "custom"
                    ]
                  },
                  "apiKey": {
                    "type": "string"
                  },
                  "baseUrl": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "delete"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "saved 或 removed"
          },
          "400": {
            "description": "provider 不支持"
          },
          "401": {
            "description": "未登录"
          }
        }
      }
    },
    "/v2/llm": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "自带 API LLM 代理",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "messages": {
                    "type": "array"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "透传上游 LLM 响应"
          },
          "401": {
            "description": "未登录"
          },
          "402": {
            "description": "未配置自带 API"
          }
        }
      }
    },
    "/v2/experiment-plan/{engine}": {
      "post": {
        "tags": [
          "engine"
        ],
        "summary": "干湿闭环种子 — 标准化实验方案模板",
        "security": [],
        "parameters": [
          {
            "name": "engine",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fixed": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "plan"
          }
        }
      }
    },
    "/v2/graph": {
      "get": {
        "tags": [
          "engine"
        ],
        "summary": "知识图谱全局统计",
        "security": [],
        "responses": {
          "200": {
            "description": "graph 全局统计"
          }
        }
      }
    },
    "/v2/graph/{engine}": {
      "get": {
        "tags": [
          "engine"
        ],
        "summary": "某引擎邻域",
        "security": [],
        "parameters": [
          {
            "name": "engine",
            "in": "path",
            "required": true,
