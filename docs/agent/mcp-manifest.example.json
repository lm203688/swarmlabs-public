{
  "manifestVersion": "1.0",
  "schemaVersion": "2025-09-13",
  "name": "swarmlabs-science-compute",
  "description": "SwarmLabs 计算实验自动化 —— 95 场景（14 学科）GP+UQ 引擎 + 157,866+ 结构化科研实体。SEP-2640 manifest 声明所需 scopes 与鉴权方案。",
  "version": "3.0.0",
  "author": {
    "name": "SwarmLabs",
    "url": "https://swarmlabs.tools",
    "email": "contact@swarmlabs.tools"
  },
  "license": "MIT",
  "homepage": "https://swarmlabs.tools",
  "repository": "https://github.com/lm203688/swarmlabs",
  "capabilities": [
    {
      "id": "microbiology-simulate",
      "type": "tool",
      "name": "微生物模拟",
      "description": "调用 GP+UQ 引擎执行 63 个微生物/跨域场景计算。返回不确定性量化结果与可行性预检。",
      "endpoint": "https://swarmlabs.tools/api/v3/microbiology"
    },
    {
      "id": "entity-retrieve",
      "type": "tool",
      "name": "结构化科研实体检索",
      "description": "在 157,866+ 结构化科研实体中检索（趋势/研究空白/跨域桥接/合著网络洞察）。",
      "endpoint": "https://swarmlabs.tools/api/v3/entities"
    },
    {
      "id": "paper-claim-validate",
      "type": "tool",
      "name": "论文声明验证",
      "description": "对科学论文中的定量声明做 UQ 覆盖度审计（对应 swarmlabs-science-compute 离线 skill）。",
      "endpoint": "https://swarmlabs.tools/api/v3/claim-validation"
    }
  ],
  "requiredScopes": [
    "swarmlabs:read",
    "swarmlabs:compute",
    "swarmlabs:entities"
  ],
  "auth": {
    "schemes": [
      {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Bearer <token>. Pro ¥39.9 / 终身 ¥199 via license.swarmlabs.tools."
      }
    ]
  },
  "requiredTools": [],
  "installCommands": [
    "npx --yes @swarmlabs/cli install",
    "pip install swarmlabs-client"
  ],
  "compatibility": {
    "minimumAgentVersion": "1.0",
    "supportedAgents": ["claude-code", "cline", "cursor", "opencode", "a2a-client"],
    "offlineAvailable": true
  },
  "allowedTools": [
    "swarmlabs:microbiology-simulate",
    "swarmlabs:entity-retrieve",
    "swarmlabs:paper-claim-validate"
  ],
  "metadata": {
    "entitiesCount": 157866,
    "scenariosCount": 63,
    "domains": ["microbiology", "synthetic-biology", "fermentation", "protein-engineering", "metabolic-engineering"],
    "targetEntities": 100000
  },
  "permissions": {
    "network": "outbound-to-swarmlabs-tools",
    "filesystem": "read-only"
  },
  "signature": {
    "algorithm": "Ed25519",
    "keyId": "swarmlabs-tools-2026-primary",
    "keyUrl": "https://swarmlabs.tools/.well-known/jwks.json",
    "signature": "[待发布签名密钥后填充]"
